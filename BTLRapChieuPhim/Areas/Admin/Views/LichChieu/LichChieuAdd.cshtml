
@{
    ViewData["Title"] = "LichChieuAdd";
    Layout = "~/Areas/Admin/Views/Shared/_LayoutTemplateAdmin.cshtml";
}

@model BTLRapChieuPhim.Models.LichChieu

<div class="container-fluid">
	<div class="row">
		<!-- main title -->
		<div class="col-12">
			<div class="main__title">
				<h2>Thêm Mới Lịch Chiếu</h2>
			</div>
		</div>
		<!-- end main title -->
		<!-- form -->
		<div class="col-12">
			<form action="#" class="sign__form sign__form--add">
				<div class="row">
					<div class="col-12 ">
						<div class="row">
							<div class="col-12 ">
								<div class="sign__group">
									<select class="sign__selectjs" id="sign__quality">
										<option value="FullHD">FullHD</option>
										<option value="HD">HD</option>
									</select>
								</div>
							</div>


							<div class="col-12">
								<div class="sign__group">

									<select class="sign__selectjs" id="sign__genre" multiple>
									</select>
								</div>
							</div>
							<div class="col-12">
								<div class="sign__group">
									<select class="sign__selectjs" id="sign__country" multiple>
									</select>
								</div>
							</div>
							<div class="col-12 ">
								<div class="sign__group">
									<input type="text" class="sign__input" placeholder="Thời gian bắt đầu">
								</div>
							</div>
						</div>
					</div>

					<div class="col-12 ">
						<div class="sign__group">
							<select class="sign__selectjs" id="sign__actors" multiple>
							</select>
						</div>
					</div>
					<div id="message" style="margin-top: 20px;"></div>
					<div class="col-12">
						<button type="button" class="sign__btn sign__btn--small"><span>Xác Nhận</span></button>
					</div>
				</div>
			</form>
		</div>
		<!-- end form -->
	</div>
</div>

<div id="message" style="margin-top: 20px;"></div>

@section scripts{
	<script src="https://ajax.googleapis.com/ajax/libs/jquery/3.5.1/jquery.min.js"></script>
	<script>
		$(document).ready(function () {
			$('#formThemLichChieu').submit(function (event) {
				event.preventDefault(); // Ngăn chặn reload trang

				const lichChieu = {
					ThoiGianChieu: $('#thoiGianChieu').val(),
					MaQl: $('#maQl').val(),
					MaPc: $('#maPc').val(),
					MaPhim: $('#maPhim').val()
				};
				console.log(JSON.stringify(lichChieu));
				$.ajax({
					type: 'POST',
					url: '/api/LichChieu', // Đường dẫn đến API
					data: JSON.stringify(lichChieu),
					contentType: 'application/json',
					success: function (response) {
						$('#message').text(response.message).css('color', 'green');
						window.location.href = '/admin/LichChieuPhim'
					},
					error: function (xhr) {
						$('#message').text(xhr.responseJSON.message).css('color', 'red');
					}
				});
			});
		});
	</script>
	<script src="js/bootstrap.bundle.min.js"></script>
	<script src="js/slimselect.min.js"></script>
	<script src="js/smooth-scrollbar.js"></script>
	<script src="js/admin.js"></script>
}

