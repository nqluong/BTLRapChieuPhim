@{
    ViewData["Title"] = "DanhSachPhongChieu";
    Layout = "~/Areas/Admin/Views/Shared/_LayoutTemplateAdmin.cshtml";
}
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
<!-- Thêm đoạn script dùng AJAX để lấy dữ liệu từ API -->

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script type="text/javascript">
    $(document).ready(function () {
        // Gọi API LichChieu bằng AJAX
        $.ajax({
            url: '/api/phongchieuapi', // Đảm bảo rằng đường dẫn đến API là đúng
            method: 'GET',
            dataType: 'json',
            success: function (data) {
                // Xây dựng HTML cho phần tiêu đề và bảng
                var tableHtml = `
                        <div class="col-12">
                            <div class="main__title">
                                <h2>Danh Sách Phòng Chiếu</h2>
                                <div class="main__title-wrap">
                                    <a href="/admin/PhongChieuAdd" class="main__title-link main__title-link--wrap">Add item</a>
                                    <!-- search -->
                                    <form action="#" class="main__title-form">
                                        <input type="text" placeholder="Find movie / tv series..">
                                        <button type="button">
                                            <i class="ti ti-search"></i>
                                        </button>
                                    </form>
                                    <!-- end search -->
                                </div>
                            </div>
                        </div>
                        <div class="catalog catalog--1" data-scrollbar="true" tabindex="-1" style="overflow: hidden; outline: none;">
                            <div class="scroll-content">
                                <table class="catalog__table">
                                    <thead>
                                        <tr>
                                            <th>MÃ PHÒNG CHIẾU</th>
                                            <th>TÊN PHÒNG CHIẾU</th>
                                            <th>SỨC CHỨA</th>
                                            <th>TÊN RẠP PHIM</th>
                                            <th>TÊN QUẢN LÍ</th>
                                            <th>THAO TÁC</th>
                                        </tr>
                                    </thead>
                                    <tbody id="phongChieuBody"></tbody>
                                </table>
                            </div>
                        </div>`;

                // Đặt HTML của bảng vào renderBodyContent
                $('#renderBodyContent').html(tableHtml);

                // Thêm từng hàng dữ liệu vào phongChieuBody
                data.forEach(function (phongchieu) {
                    var row = `
                            <tr>
                                <td><div class="catalog__text">${phongchieu.maPc}</div></td>
                                <td><div class="catalog__text"><a href="#">${phongchieu.tenPc}</a></div></td>
                                <td><div class="catalog__text">${phongchieu.sucChua}</div></td>
                                <td><div class="catalog__text">${phongchieu.tenRp}</div></td>
                                <td><div class="catalog__text">${phongchieu.hoTen}</div></td>
                                <td>
                                    <div class="catalog__btns">
                                        <button type="button" class="catalog__btn catalog__btn--edit" onclick="editPhongChieu('${phongchieu.maPc}')">
                                            <i class="ti ti-edit"></i>
                                        </button>
                                        <button type="button" class="catalog__btn catalog__btn--delete" onclick="deletePhongChieu('${phongchieu.maPc}')">
                                            <i class="ti ti-trash"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>`;
                    $('#phongChieuBody').append(row);
                });
            },
            error: function (error) {
                console.error('Lỗi khi gọi API PhongChieu:', error);
            }
        });
    });

    function editPhongChieu(maPc) {
        // Điều hướng đến trang cập nhật với mã Phòng Chiếu
        window.location.href = `/admin/PhongChieuUpdate?maPc=${maPc}`;
    }

    function deletePhongChieu(maPc) {
        if (confirm("Bạn có chắc chắn muốn xóa phòng chiếu này?")) {
            $.ajax({
                url: `/api/phongchieuapi/${maPc}`, // Đường dẫn đến API xóa
                method: 'DELETE',
                success: function (response) {
                    alert(response.message);
                    // Tải lại danh sách sau khi xóa
                    loadPhongChieu();
                },
                error: function (error) {
                    console.error('Lỗi khi gọi API xóa phòng chiếu:', error);
                    alert("Xóa phòng chiếu thất bại!");
                }
            });
        }
    }
</script>
