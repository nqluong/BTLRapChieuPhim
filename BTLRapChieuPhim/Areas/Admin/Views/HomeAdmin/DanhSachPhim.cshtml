@{
    ViewData["Title"] = "DanhSachPhim";
    Layout = "~/Areas/Admin/Views/Shared/_LayoutTemplateAdmin.cshtml";
}
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

<div class="col-12">
    <div class="main__title">
        <h2>Danh Sách Phim</h2>
        <div class="main__title-wrap">
            <a href="#" id="addItemLink" class="main__title-link main__title-link--wrap">Add item</a>
            <form action="#" class="main__title-form">
                <input type="text" placeholder="Find movie / tv series..">
                <button type="button">
                    <i class="ti ti-search"></i>
                </button>
            </form>
        </div>
    </div>
</div>

<div class="catalog catalog--1" data-scrollbar="true" tabindex="-1" style="overflow: hidden; outline: none;">
    <div class="scroll-content">
        <table class="catalog__table">
            <thead>
                <tr>
                    <th>MÃ PHIM</th>
                    <th>TÊN PHIM</th>
                    <th>THỜI LƯỢNG</th>
                    <th>ĐẠO DIỄN</th>
                    <th>ĐỘ TUỔI</th>
                    <th>QUỐC GIA</th>
                    <th>THỂ LOẠI</th>
                    <th>HÀNH ĐỘNG</th>
                </tr>
            </thead>
            <tbody id="phimBody">
                <!-- Dữ liệu từ AJAX sẽ được thêm vào đây -->
            </tbody>
        </table>
    </div>
</div>

<!-- Script dùng AJAX để lấy dữ liệu từ API -->
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script type="text/javascript">
    $(document).ready(function () {

        // Gọi API Phim bằng AJAX
        $.ajax({
            url: '/api/phimapi', // Đảm bảo rằng đường dẫn đến API là đúng
            method: 'GET',
            dataType: 'json',
            success: function (data) {
                // Xóa dữ liệu cũ (nếu có)
                $('#phimBody').empty();

                // Lặp qua từng bản ghi và thêm vào bảng
                data.forEach(function (phim) {
                    var row = `
                            <tr>
                                <td><div class="catalog__text">${phim.maPhim}</div></td>
                                <td><div class="catalog__text"><a href="#">${phim.tenPhim}</a></div></td>
                                <td><div class="catalog__text">${phim.thoiLuong} phút</div></td>
                                <td><div class="catalog__text">${phim.daoDien}</div></td>
                                <td><div class="catalog__text">${phim.doTuoi}+</div></td>
                                <td><div class="catalog__text">${phim.nuocSx}</div></td>
                                <td><div class="catalog__text">${phim.tenTheLoai}</div></td>
                                <td>
                                    <div class="catalog__btns">
                                        <button type="button" class="catalog__btn catalog__btn--edit" onclick="editPhim('${phim.maPhim}')">
                                            <i class="ti ti-edit"></i>
                                        </button>
                                        <button type="button" class="catalog__btn catalog__btn--delete" onclick="deletePhim('${phim.maPhim}')">
                                            <i class="ti ti-trash"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>`;
                    $('#phimBody').append(row);
                });
            },
            error: function (error) {
                console.error('Lỗi khi gọi API Phim:', error);
            }
        });
    });

    function editPhim(maPhim) {
        // Điều hướng đến trang cập nhật với mã Phim
        window.location.href = `/admin/PhimUpdate?maPhim=${maPhim}`;
    }

    function deletePhim(maPhim) {
        if (confirm("Bạn có chắc chắn muốn xóa phim này?")) {
            $.ajax({
                url: `/api/phimapi/${maPhim}`, // Đường dẫn đến API xóa
                method: 'DELETE',
                success: function (response) {
                    alert(response.message);
                    // Gọi lại API để làm mới dữ liệu trong bảng
                    location.reload();
                },
                error: function (error) {
                    console.error('Lỗi khi gọi API xóa phim:', error);
                    alert("Xóa phim thất bại!");
                }
            });
        }
    }
</script>
