
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script>
    function showProductByCategory() {
        var contentHtml = '';
        $.ajax({
            url: '/api/phongchieuapi', // Đảm bảo rằng đường dẫn đến API là đúng
            method: 'GET',
            dataType: 'json',
            success: function (data) {
                console.log(data);
                contentHtml += `
                        <div class="col-12">
                            <div class="main__title">
                                <h2>Danh Sách Phòng Chiếu</h2>
                                <div class="main__title-wrap">
                                        <a href = "/admin/PhongChieuAdd" class="main__title-link main__title-link--wrap">Thêm phòng chiếu</a>
                                </div>
                            </div>
                        </div>
                        <div class="catalog catalog--1" data-scrollbar="true" tabindex="-1" style="overflow: hidden; outline: none;">
                            <div class="scroll-content">
                                <table class="catalog__table">
                                    <thead>
                                        <tr>
                                            <th>MÃ PHÒNG CHIẾU</th>
                                            <th>TÊN PHÒNG CHIẾU</th>
                                            <th>SỨC CHỨA</th>
                                            <th>TÊN RẠP PHIM</th>
                                            <th>HÀNH ĐỘNG</th>
                                        </tr>
                                    </thead>
                                    <tbody id="phongChieuBody">`;

                // Lặp qua từng phòng chiếu và thêm vào HTML
                data.forEach(function (phongchieu) {
                    contentHtml += `
                            <tr>
                                <td><div class="catalog__text">${phongchieu.maPc}</div></td>
                                <td><div class="catalog__text"><a href="#">${phongchieu.tenPc}</a></div></td>
                                <td><div class="catalog__text">${phongchieu.sucChua}</div></td>
                                <td><div class="catalog__text">${phongchieu.tenRp}</div></td>
                                <td>
                                    <div class="catalog__btns">
                                        <button type="button" class="catalog__btn catalog__btn--edit" onclick="editPhongChieu('${phongchieu.maPc}')">
                                            <i class="ti ti-edit"></i>
                                        </button>
                                        <button type="button" class="catalog__btn catalog__btn--delete" onclick="deletePhongChieu('${phongchieu.maPc}')">
                                            <i class="ti ti-trash"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>`;
                });

                // Đóng các thẻ HTML
                contentHtml += `
                                    </tbody>
                                </table>
                            </div>
                        </div>`;

                // Thêm HTML vào phần tử hiển thị
                $('#renderBodyContent').html(contentHtml);
            },
            error: function (xhr) {
                alert("Lỗi khi tải danh sách phòng chiếu: " + xhr.responseText);
            }
        });
    }

    function editPhongChieu(maPc) {
        window.location.href = `/admin/PhongChieuUpdate?maPc=${maPc}`;
    }

    function deletePhongChieu(maPc) {
        if (confirm("Bạn có chắc chắn muốn xóa phòng chiếu này?")) {
            $.ajax({
                url: `/api/phongchieuapi/${maPc}`,
                method: 'DELETE',
                success: function (response) {
                    alert(response.message);
                    showProductByCategory(); // Làm mới danh sách
                },
                error: function (error) {
                    alert("Xóa phòng chiếu thất bại!");
                }
            });
        }
    }

    
</script>