<script src="https://ajax.googleapis.com/ajax/libs/jquery/3.5.1/jquery.min.js"></script>
<script>
    function loadSeats(malc) {
        $.ajax({
            url: `/api/PhongChieuAPI/byLC/${malc}`,
            type: 'GET',
            success: function (bookedSeats) {
                const allSeats = [];
                const rows = ['A', 'B', 'C'];
                let seatId = 24;
                rows.forEach(row => {
                    for (let i = 1; i <= 23; i++) {
                        allSeats.push({
                            MaGxp: `${seatId}`,  
                            Row: row,
                            LoaiGhe: 'Thường',
                            TrangThai: 'Còn Trống'  
                        });
                        seatId++;
                    }
                });

                if (bookedSeats && bookedSeats.length > 0) {
                    bookedSeats.forEach(bookedSeat => {
                        // Tìm ghế trong danh sách allSeats với MaGxp dưới dạng chuỗi
                        const seat = allSeats.find(seat => seat.MaGxp === bookedSeat.maGxp.toString());

                        if (seat) {
                            console.log(`Updating seat ${seat.MaGxp} from ${seat.TrangThai} to ${bookedSeat.trangThai}`);
                            seat.TrangThai = bookedSeat.trangThai;  // Cập nhật trạng thái
                        } else {
                            console.log(`Seat with MaGxp ${bookedSeat.maGxp} not found in allSeats.`);
                        }
                    });
                }

                renderSeats(allSeats);
            },
            error: function (xhr, status, error) {
                console.error("Error fetching seats:", error);
                $('#seatContainer').html('<p>Không tìm thấy ghế cho lịch chiếu này.</p>');
            }
        });
    }

    function renderSeats(seats) {
        const seatContainer = $('#seatContainer');
        seatContainer.empty();

        const groupedSeats = seats.reduce((acc, seat) => {
            if (!acc[seat.Row]) acc[seat.Row] = [];
            acc[seat.Row].push(seat);
            return acc;
        }, {});

        Object.keys(groupedSeats).forEach(row => {
            const rowList = $('<ul class="st_eco_second_row"></ul>');
            const rowHeader = $(`<li class="st_seat_heading_row">${row}</li>`);
            rowList.append(rowHeader);

            groupedSeats[row].forEach(seat => {
                const isDisabled = seat.TrangThai === 'Đã Đặt';
                console.log(`Seat: ${seat.MaGxp}, Status: ${seat.TrangThai}, Disabled: ${isDisabled}`);
                const seatItem = $(`
                    <li class="${isDisabled ? 'seat_disable' : ''}">
							<input type="checkbox" id="c${seat.MaGxp}"  class ="${row}" name="cb" ${isDisabled ? 'disabled' : ''}>
                        <label for="c${seat.MaGxp}"></label>
                    </li>
                `);
                rowList.append(seatItem);
            });

            seatContainer.append(rowList);
        });
    }


    $(document).ready(function () {
		const maLc = @ViewBag.MaLC
		const maPhim = @ViewBag.MaPhim
		const tgc = '@ViewBag.Tgc';
		console.log(tgc)
		loadShowTTByMovieId(maPhim);
        loadSeats(maLc);
    });
	function protfolioIsotope() {
		if ($('.st_fb_filter_left_box_wrapper').length) {
			// Activate isotope in container
			$(".protfoli_inner, .portfoli_inner").imagesLoaded(function () {
				$(".protfoli_inner, .portfoli_inner").isotope({
					layoutMode: 'masonry',
				});
			});

			// Add isotope click function
			$(".protfoli_filter li").on('click', function () {
				$(".protfoli_filter li").removeClass("active");
				$(this).addClass("active");
				var selector = $(this).attr("data-filter");
				$(".protfoli_inner, .portfoli_inner").isotope({
					filter: selector,
					animationOptions: {
						duration: 450,
						easing: "linear",
						queue: false,
					}
				});
				return false;
			});
		};
	};
	protfolioIsotope();

	function changeQty(increase) {
		var qty = parseInt($('.select_number').find("input").val());
		if (!isNaN(qty)) {
			qty = increase ? qty + 1 : (qty > 1 ? qty - 1 : 1);
			$('.select_number').find("input").val(qty);
		} else {
			$('.select_number').find("input").val(1);
		}
	}
    $(document).ready(function () {
        const maxSeatsInput = $('#input-quantity');

        function updateMaxSelectableSeats() {
            return parseInt(maxSeatsInput.val()) || 1;
        }

        function checkSeatLimit() {
            const selectedSeats = $('input[name="cb"]:checked').length;
            const maxSeats = updateMaxSelectableSeats();
            if (selectedSeats >= maxSeats) {
                $('input[name="cb"]:not(:checked)').prop('disabled', true);
            } else {
                $('input[name="cb"]').prop('disabled', false);
            }
        }

        // Cập nhật giới hạn chọn ghế khi thay đổi số lượng vé
        maxSeatsInput.on('input change', function () {
            checkSeatLimit();
        });

        // Sử dụng delegation để bắt sự kiện change cho các checkbox được thêm bằng Ajax
        $('#seatContainer').on('change', 'input[name="cb"]', function () {
            checkSeatLimit();
        });

        window.changeQty = function (increase) {
            let qty = parseInt(maxSeatsInput.val()) || 1;
            qty = increase ? qty + 1 : Math.max(1, qty - 1);
            maxSeatsInput.val(qty);
            checkSeatLimit();
        };
    });
	function loadShowTTByMovieId(maPhim) {
		$.get(`/api/lichchieuapi/ttphim/${maPhim}`, function (data) {
			const movieInfoContainer = document.getElementById('movie-info');
			movieInfoContainer.innerHTML = ''; // Xóa nội dung cũ

			// Kiểm tra nếu có dữ liệu phim, thêm thông tin phim vào container
			if (data && data.length > 0) {
				const movie = data[0]; // Lấy phần tử đầu tiên trong mảng
				movieInfoContainer.innerHTML = `
					<h3>${movie.tenPhim} - ${movie.nuocSx} - ${movie.thoiLuong} mins</h3>
					
				`;
			} else {
				movieInfoContainer.innerHTML = `<h3>Không có thông tin cho phim này.</h3>`;
			}
		}).fail(function () {
			alert("Không thể tải thông tin phim. Vui lòng thử lại sau.");
		});
	}
	function saveSelectedSeats() {
		let selectedSeats = [];

		// Lấy giá trị từ ViewBag và chuyển thành chuỗi JavaScript
		const maLc = "@ViewBag.MaLC";  // Đảm bảo rằng maLc không phải null
		const maPhim = "@ViewBag.MaPhim";  // Đảm bảo rằng maPhim không phải null
		const gio = '@ViewBag.Gio';
		const tgc = '@ViewBag.Tgc';
		if (!maLc || !maPhim) {
			alert("Thông tin không hợp lệ.");
			return;
		}

		$.get(`/api/lichchieuapi/ttphim/${maPhim}`, function (ttphim) {
    // Kiểm tra nếu API trả về một mảng và phần tử đầu tiên chứa thông tin phim
    if (Array.isArray(ttphim) && ttphim.length > 0 && ttphim[0].tenPhim) {
        const phim = ttphim[0]; // Lấy đối tượng phim đầu tiên trong mảng

        // Lấy danh sách ghế đã chọn
        $('input[name="cb"]:checked').each(function () {
            let seat = parseInt($(this).attr('id').replace('c', ''), 10); // Lấy ID ghế và chuyển thành số nguyên
            const seatId = $(this).attr('id').replace('c', '');
            const row = $(this).attr('class');
			
            // Điều chỉnh vị trí ghế cho các hàng khác nhau
            if (row === 'A') seat -= 23;
            else if (row === 'B') seat -= 46;
            else seat -= 69;

            selectedSeats.push({
                MaLc: maLc,
                MaPhim: maPhim,
                TenPhim: phim.tenPhim,  
                MaGxp: seatId,
                Ghe: row + seat,
                GiaVe: 100000,
				Gio: gio,
				Tgc: tgc
            });
        });

        console.log("Dữ liệu ghế đã chọn:", JSON.stringify(selectedSeats));
        if (selectedSeats.length === 0) {
            alert("Vui lòng chọn ít nhất một ghế!");
            return;
        }

        // Gửi dữ liệu ghế đã chọn đến API
        $.ajax({
            url: `https://localhost:7199/api/veapi/TTve/${maLc}`,
            type: 'POST',
            contentType: 'application/json',
            data: JSON.stringify(selectedSeats),
            success: function (response) {
						window.location.href = `/Home/Checkout?maLC=${maLc}&maPhim=${maPhim}&tgc=${tgc}&gio=${gio}`;
            },
            error: function (xhr, status, error) {
                console.error("Lỗi khi lưu ghế đã chọn:", error);
                console.log("Chi tiết lỗi:", xhr.responseText);
                alert("Có lỗi xảy ra khi lưu ghế đã chọn. Vui lòng thử lại.");
            }
        });
    } else {
        alert("Không tìm thấy thông tin phim.");
        console.log("API không trả về dữ liệu hoặc thiếu thuộc tính TenPhim:", ttphim);
    }
}).fail(function(xhr, status, error) {
    console.error("Lỗi khi gọi API:", error);
    console.log("Chi tiết lỗi:", xhr.responseText);
    alert("Lỗi khi lấy thông tin phim từ API. Vui lòng kiểm tra.");
});}
	document.getElementById('backButton').addEventListener('click', function (event) {
		const maPhim = '@ViewBag.MaPhim';
		window.location.href = `/Home/LichChieu?maPhim=${maPhim}`;
		
	});

</script>
