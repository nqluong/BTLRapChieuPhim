@{
    Layout = null; // Đảm bảo không sử dụng layout mặc định
}

@model TaiKhoan

<!DOCTYPE html>
<html lang="en">
<head>

    <meta charset="utf-8" />
    <title>Login - Movie Pro</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="stylesheet" type="text/css" href="../Template/css/bootstrap.css" />
    <link rel="stylesheet" type="text/css" href="../Template/css/style.css" />
    <link rel="stylesheet" type="text/css" href="../Template/css/responsive.css" />
    <style>
        /* Đảm bảo container co giãn theo kích thước màn hình */
        .container {
            max-width: 100%; /* Cho phép container co giãn hoàn toàn */
            padding-left: 15px;
            padding-right: 15px;
        }

        .st_pop_form_wrapper {
            padding: 20px; /* Thêm padding */
            border: 1px solid #ddd;
            border-radius: 5px;
            background-color: #fff;
            box-sizing: border-box; /* Đảm bảo không thay đổi kích thước */
            width: 100%; /* Cho phép phần tử này co giãn */
        }

        .st_profile_input, .st_profile__pass_input {
            margin-bottom: 15px;
        }

        .st_form_pop_fp, .st_form_pop_or_btn, .st_form_pop_login_btn {
            margin-bottom: 5px;
            text-align: center;
        }

        .st_form_pop_signin_btn {
            margin-top: 120px;
        }

        /* Đảm bảo canh giữa đúng vị trí */
        .row.justify-content-center {
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh; /* Đảm bảo toàn bộ chiều cao */
        }
    </style>
</head>

<body>
    <div class="container">
        <div class="row justify-content-center" style="margin-top: 100px;">
            <div class="col-md-6">
                <div class="st_pop_form_wrapper">
                    <div class="st_pop_form_heading_wrapper text-center">
                        <h3>Log in</h3>
                    </div>
                    @using (Html.BeginForm("Login", "Access", FormMethod.Post))
                    {
                        <div class="st_profile_input">
                            <label>User Name</label>
                            @Html.TextBoxFor(x => x.Username, new { @class = "form-control", placeholder = "Enter your name" })
                            @Html.ValidationMessageFor(x => x.Username, "", new { @class = "text-danger" })
                        </div>
                        <div class="st_profile_input">
                            <label>Password</label>
                            @Html.PasswordFor(x => x.Password, new { @class = "form-control", placeholder = "Enter your password" })
                            @Html.ValidationMessageFor(x => x.Password, "", new { @class = "text-danger" })
                        </div>
                        <div class="st_form_pop_fp text-center">
                            <h3><a href="#" data-toggle="modal" data-target="#myModa2">Forgot Password?</a></h3>
                        </div>
                        <div class="st_form_pop_login_btn">
                            <button type="submit" class="btn btn-primary btn-block">LOGIN</button>
                        </div>
                        <div class="st_form_pop_or_btn text-center">
                            <h4>or</h4>
                        </div>
                        <div class="st_form_pop_facebook_btn text-center">
                            <a href="#" class="btn btn-outline-primary btn-block">Connect with Facebook</a>
                        </div>
                        <div class="st_form_pop_gmail_btn text-center">
                            <a href="#" class="btn btn-outline-danger btn-block">Connect with Google</a>
                        </div>
                        <div class="st_form_pop_signin_btn text-center">
                            <h4>Don’t have an account? <a href="#" data-toggle="modal" data-target="#myModa3">Sign Up</a></h4>
                            <h5>I agree to the <a href="#">Terms & Conditions</a> & <a href="#">Privacy Policy</a></h5>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Include your JavaScript files here -->
    <script src="../Template/js/jquery_min.js"></script>
    <script src="../Template/js/bootstrap.js"></script>
    <script src="../Template/js/custom.js"></script>
</body>
</html>

