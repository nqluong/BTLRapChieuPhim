﻿@{
	Layout = null; // Đảm bảo không sử dụng layout mặc định
}

@model TaiKhoan


<!DOCTYPE html>
<html lang="en">

<!-- Mirrored from hotflix.volkovdesign.com/admin/signin.html by HTTrack Website Copier/3.x [XR&CO'2014], Thu, 26 Sep 2024 17:40:21 GMT -->
<head>
	<meta charset="utf-8">
	<meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">

	<!-- CSS -->
	<link rel="stylesheet" href="/TemplateAdmin/css/bootstrap.min.css">
	<link rel="stylesheet" href="/TemplateAdmin/css/slimselect.css">
	<link rel="stylesheet" href="/TemplateAdmin/css/admin.css">

	<!-- Icon font -->
	<link rel="stylesheet" href="/TemplateAdmin/webfont/tabler-icons.min.css">

	<!-- Favicons -->
	<link rel="icon" type="image/png" href="/TemplateAdmin/icon/favicon-32x32.png" sizes="32x32">
	<link rel="apple-touch-icon" href="/TemplateAdmin/icon/favicon-32x32.png">

	<meta name="description" content="Online Movies, TV Shows & Cinema HTML Template">
	<meta name="keywords" content="">
	<meta name="author" content="Dmitry Volkov">
	<title>HotFlix – Online Movies, TV Shows & Cinema HTML Template</title>
</head>

<body>
	<div class="sign section--bg" data-bg="/TemplateAdmin/img/section/section.jpg">
		<div class="container">
			<div class="row">
				<div class="col-12">
					<div class="sign__content">
						<!-- authorization form -->
						@* <form action="#" class="sign__form"> *@
							@using(Html.BeginForm("Login", "Access", FormMethod.Post))
							{
								<a href="index.html" class="sign__logo">
									<img src="/TemplateAdmin/img/logo.svg" alt="">
								</a>

								<div class="sign__group">
								@Html.TextBoxFor(x => x.Username, new { @class = "sign__input", placeholder = "Username", required = "required", autofocus ="autofocus" })
									@* <input type="text" class="sign__input" placeholder="Email"> *@
								</div>

								<div class="sign__group">
								@Html.TextBoxFor(x => x.Password, new { @class = "sign__input", placeholder = "Password", type = "text", id = "password" })
									@* <input type="password" class="sign__input" placeholder="Password"> *@
								</div>

								<div class="sign__group sign__group--checkbox">
									<input id="remember" name="remember" type="checkbox" checked="checked">
									<label for="remember">Remember Me</label>
								</div>

								<button class="sign__btn" type="submit">Sign in</button>

								<span class="sign__text">Don't have an account? <a href="/Access/SignUp">Sign up!</a></span>

								<span class="sign__text"><a href="/Access/ForgotPassword">Forgot password?</a></span>
							}
						@* </form> *@
						<!-- end authorization form -->
					</div>
				</div>
			</div>
		</div>
	</div>

	<!-- JS -->
	<script src="/TemplateAdmin/js/bootstrap.bundle.min.js"></script>
	<script src="/TemplateAdmin/js/slimselect.min.js"></script>
	<script src="/TemplateAdmin/js/smooth-scrollbar.js"></script>
	<script src="/TemplateAdmin/js/admin.js"></script>

	<script>
		document.getElementById('remember').addEventListener('change', function () {
			const passwordInput = document.getElementById('password');
			if (this.checked) {
				passwordInput.type = 'text'; // Hiển thị mật khẩu
			} else {
				passwordInput.type = 'password'; // Ẩn mật khẩu
			}
		});
	</script>
</body>

<!-- Mirrored from hotflix.volkovdesign.com/admin/signin.html by HTTrack Website Copier/3.x [XR&CO'2014], Thu, 26 Sep 2024 17:40:25 GMT -->
</html>