
@{
    Layout = null;
}

@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

<!DOCTYPE html>
<html lang="en">

<!-- Mirrored from hotflix.volkovdesign.com/admin/forgot.html by HTTrack Website Copier/3.x [XR&CO'2014], Thu, 26 Sep 2024 17:40:25 GMT -->
<head>
	<meta charset="utf-8">
	<meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">

	<!-- CSS -->
	<link rel="stylesheet" href="/TemplateAdmin/css/bootstrap.min.css">
	<link rel="stylesheet" href="/TemplateAdmin/css/slimselect.css">
	<link rel="stylesheet" href="/TemplateAdmin/css/admin.css">

	<!-- Icon font -->
	<link rel="stylesheet" href="/TemplateAdmin/webfont/tabler-icons.min.css">

	<!-- Favicons -->
	<link rel="icon" type="image/png" href="/TemplateAdmin/icon/favicon-32x32.png" sizes="32x32">
	<link rel="apple-touch-icon" href="/TemplateAdmin/icon/favicon-32x32.png">

	<meta name="description" content="Online Movies, TV Shows & Cinema HTML Template">
	<meta name="keywords" content="">
	<meta name="author" content="Dmitry Volkov">
	<title>HotFlix – Online Movies, TV Shows & Cinema HTML Template</title>
</head>

<body>
	@if (ViewBag.Password != null)
	{
		<div class="alert alert-success mt-3">
			<strong>Your Password:</strong> @ViewBag.Password
		</div>
	}
	@if (ViewBag.Error != null)
	{
		<div class="alert alert-danger mt-3">
			<strong>Error:</strong> @ViewBag.Error
		</div>
	}
	<div class="sign section--bg" data-bg="/TemplateAdmin/img/section/section.jpg">
		<div class="container">
			<div class="row">
				<div class="col-12">
					<div class="sign__content">
						<!-- forgot form -->
						<form asp-controller="Access" asp-action="ForgotPassword" method="post" class="sign__form">
							<a href="index.html" class="sign__logo">
								<img src="/TemplateAdmin/img/logo.svg" alt="">
							</a>

							<div class="sign__group">
								<input type="email" name="email" class="sign__input" placeholder="Email" required/>
							</div>

							<button class="sign__btn" type="submit">Send</button>

							<span class="sign__text"><a asp-controller="Access" asp-action="Login">Sign in!</a></span>
						</form>
						<!-- end forgot form -->
					</div>
				</div>
			</div>
		</div>
	</div>

	<!-- JS -->
	<script src="/TemplateAdmin/js/bootstrap.bundle.min.js"></script>
	<script src="/TemplateAdmin/js/slimselect.min.js"></script>
	<script src="/TemplateAdmin/js/smooth-scrollbar.js"></script>
	<script src="/TemplateAdmin/js/admin.js"></script>
</body>

<!-- Mirrored from hotflix.volkovdesign.com/admin/forgot.html by HTTrack Website Copier/3.x [XR&CO'2014], Thu, 26 Sep 2024 17:40:25 GMT -->
</html>
